# Copy to .env.ocean-proof.local. Do not commit the private file.
# This template is for the step 10 external Ocean/Oncompute proof gate.
# For local Ocean Node proof, use .env.ocean-demo-stack instead.

# Adapter HTTP service. Keep it private and set a unique API key with at least
# 32 characters before exposing /jobs or /config.
OCEAN_WORKLOAD_ADAPTER_HOST=127.0.0.1
OCEAN_WORKLOAD_ADAPTER_PORT=8787
OCEAN_WORKLOAD_ADAPTER_MODE=live
OCEAN_WORKLOAD_ADAPTER_API_KEY=
OCEAN_WORKLOAD_ADAPTER_DATA_DIR=data/ocean-workload-adapter

# Ocean CLI checkout. Run scripts/bootstrap-ocean-cli.sh first and keep the
# printed path here, or set FISH_OCEAN_CLI_BIN to a reviewed CLI binary.
OCEAN_CLI_DIR=.deps/ocean-cli
FISH_OCEAN_CLI_BIN=

# Dedicated low-funds proof wallet and Base mainnet RPC.
# Use either OCEAN_PROOF_PRIVATE_KEY or OCEAN_PROOF_MNEMONIC, not both.
OCEAN_PROOF_PRIVATE_KEY=
OCEAN_PROOF_MNEMONIC=
OCEAN_PROOF_RPC=
ADDRESS_FILE=

# Selected external Ocean / Oncompute node and workload inputs.
NODE_URL=
FISH_OCEAN_DATASET_DIDS=[]
FISH_OCEAN_ALGO_DID=
FISH_OCEAN_COMPUTE_ENV_ID=
FISH_ALGORITHM_FILE_URL=
FISH_ALGORITHM_CHAIN_ID=8453

# Paid jobs only. Leave both empty when the selected external compute
# environment is intentionally free for the proof wallet.
FISH_OCEAN_PAYMENT_TOKEN=
FISH_OCEAN_RESOURCES=
FISH_OCEAN_ADAPTER_PROVIDER_COST_USD=

# Optional durable output JSON if the selected algorithm supports it.
FISH_OCEAN_OUTPUT=

# CLI command names are configurable because Ocean CLI docs and releases can drift.
AVOID_LOOP_RUN=true
FISH_OCEAN_START_FREE_COMMAND=startFreeCompute
FISH_OCEAN_START_PAID_COMMAND=startCompute
FISH_OCEAN_DOWNLOAD_COMMAND=downloadJobResults
FISH_OCEAN_DOWNLOAD_ARGS_TEMPLATE={jobId} {index} {outputDir}
FISH_OCEAN_RESULT_INDEX=0
FISH_OCEAN_RESULT_TIMEOUT_MS=900000
FISH_OCEAN_POLL_INTERVAL_MS=15000

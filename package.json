{
  "name": "opfish",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "mkdir -p .next/standalone/.next/static .next/standalone/public && cp -R .next/static/. .next/standalone/.next/static/ && cp -R public/. .next/standalone/public/ && node .next/standalone/server.js",
    "test:app": "tsx --test src/lib/*.test.ts",
    "readiness:public-testnet": "node scripts/audit-public-testnet-readiness.mjs",
    "backup:runtime": "node scripts/backup-runtime-data.mjs",
    "secrets:public-testnet": "node scripts/generate-public-testnet-secrets.mjs",
    "ocean-demo:web-env": "node scripts/print-ocean-demo-web-env.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "smoke": "npm run typecheck && npm run build",
    "verify": "npm run lint && npm run test:app && npm run smoke",
    "contracts:compile": "npm --prefix contracts run compile",
    "contracts:deploy:testnet": "npm --prefix contracts run deploy:testnet",
    "contracts:test": "npm --prefix contracts test"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "^2.52.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}

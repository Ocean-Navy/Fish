{
  "name": "@opfish/contracts",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:testnet": "hardhat run scripts/deploy-testnet.js --network baseSepolia",
    "security": "npm run compile && npm run test && npm run security:static",
    "security:docker": "npm run test && npm run security:static:docker",
    "security:strict": "npm run compile && npm run test && npm run security:static:strict",
    "security:static": "node scripts/run-static-analysis.js",
    "security:static:docker": "node scripts/run-slither-docker.js",
    "security:static:strict": "node scripts/run-static-analysis.js --strict",
    "test": "hardhat test",
    "test:invariants": "hardhat test test/fish-contract-invariants.test.js",
    "test:unit": "hardhat test test/fish-contracts.test.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.26.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.2.0",
    "@openzeppelin/contracts-upgradeable": "^5.2.0"
  }
}

# Copy to .env.ocean-demo-stack and edit before starting the GPU/Ocean demo stack.
# Do not commit the edited env file.

# Shared
TYPESENSE_API_KEY=change-me-typesense-key

# Ocean Node
OCEAN_NODE_IMAGE=oceanprotocol/ocean-node:latest
OCEAN_TYPESENSE_IMAGE=typesense/typesense:26.0
OCEAN_NODE_PRIVATE_KEY=
OCEAN_NODE_ALLOWED_ADMINS=[]
OCEAN_NODE_RPCS={"8453":{"rpc":"https://mainnet.base.org","chainId":8453,"network":"base","chunkSize":100},"84532":{"rpc":"https://sepolia.base.org","chainId":84532,"network":"base-sepolia","chunkSize":100}}
OCEAN_NODE_INTERFACES=["HTTP","P2P"]
OCEAN_NODE_INDEXER_NETWORKS=[]
OCEAN_NODE_JWT_SECRET=change-me-ocean-node-jwt
OCEAN_NODE_HTTP_BIND=127.0.0.1
OCEAN_NODE_HTTP_PORT=8000
OCEAN_NODE_P2P_BIND=0.0.0.0
OCEAN_NODE_P2P_TCP_PORT=9000
OCEAN_NODE_P2P_WS_PORT=9001
OCEAN_NODE_P2P_V6_TCP_PORT=9002
OCEAN_NODE_P2P_V6_WS_PORT=9003
OCEAN_NODE_P2P_ENABLE_IPV4=true
OCEAN_NODE_P2P_ENABLE_IPV6=false
OCEAN_NODE_P2P_ANNOUNCE_ADDRESSES=[]
OCEAN_NODE_P2P_ANNOUNCE_PRIVATE=false
OCEAN_NODE_IPFS_GATEWAY=https://ipfs.io/
OCEAN_NODE_ARWEAVE_GATEWAY=https://arweave.net/
OCEAN_NODE_LOG_LEVEL=info
OCEAN_NODE_LOG_CONSOLE=true
OCEAN_NODE_PERSISTENT_STORAGE={"enabled":true,"type":"localfs","accessLists":[],"options":{"folder":"/data/persistent-storage"}}

# Generate this on the GPU host:
#   node scripts/generate-ocean-node-compute-env.mjs --env
# Then paste the printed value here.
OCEAN_NODE_DOCKER_COMPUTE_ENVIRONMENTS=[]

# Private Ocean workload adapter behind FISH_OCEAN_BATCH_ENDPOINT.
OCEAN_WORKLOAD_ADAPTER_BIND=127.0.0.1
OCEAN_WORKLOAD_ADAPTER_PORT=8787
OCEAN_WORKLOAD_ADAPTER_MODE=dry_run
OCEAN_WORKLOAD_ADAPTER_API_KEY=change-me-adapter-key
OCEAN_CLI_DIR=/ocean-cli
FISH_OCEAN_CLI_BIN=
OCEAN_PROOF_PRIVATE_KEY=
OCEAN_PROOF_MNEMONIC=
OCEAN_PROOF_RPC=
NODE_URL=http://ocean-node:8000
FISH_OCEAN_DATASET_DIDS=[]
FISH_OCEAN_ALGO_DID=
FISH_OCEAN_COMPUTE_ENV_ID=
FISH_ALGORITHM_FILE_URL=
FISH_OCEAN_PAYMENT_TOKEN=
FISH_OCEAN_RESOURCES=
FISH_OCEAN_ADAPTER_PROVIDER_COST_USD=0
FISH_OCEAN_OUTPUT=
FISH_OCEAN_START_FREE_COMMAND=startFreeCompute
FISH_OCEAN_START_PAID_COMMAND=startCompute
FISH_OCEAN_DOWNLOAD_COMMAND=downloadJobResults
FISH_OCEAN_DOWNLOAD_ARGS_TEMPLATE={jobId} {index} {outputDir}
FISH_OCEAN_RESULT_INDEX=0
FISH_OCEAN_RESULT_TIMEOUT_MS=900000
FISH_OCEAN_POLL_INTERVAL_MS=15000

# Warm inference profile. Start with:
#   docker compose -f deploy/ocean-demo-stack/docker-compose.yml --env-file .env.ocean-demo-stack --profile warm up -d
FISH_VLLM_IMAGE=vllm/vllm-openai:latest
FISH_VLLM_BIND=127.0.0.1
FISH_VLLM_PORT=8000
FISH_VLLM_API_KEY=change-me-vllm-key
FISH_VLLM_MODEL=Qwen/Qwen3-8B
FISH_VLLM_SERVED_MODEL_NAME=fish-warm-chat
FISH_VLLM_MAX_MODEL_LEN=4096
FISH_VLLM_GPU_MEMORY_UTILIZATION=0.88
HUGGING_FACE_HUB_TOKEN=

FISH_RUNNER_BIND=127.0.0.1
FISH_RUNNER_PORT=8088
FISH_RUNNER_ID=runner_ocean_navy_demo
FISH_RUNNER_PROVIDER_ID=ocean-navy-demo-node
FISH_RUNNER_API_KEY=change-me-runner-key
FISH_RUNNER_PRICE_USD_PER_1K_TOKENS=0
FISH_RUNNER_MAX_QUEUE=2
FISH_RUNNER_SIGNING_PRIVATE_KEY_PEM=
FISH_RUNNER_SIGNING_KEY_ID=runner-ocean-navy-demo-ed25519

# Apple Silicon local inference profile. Run mlx_lm.server on the macOS host,
# then start the Compose stack with --profile mlx.
FISH_MLX_BASE_URL=http://host.docker.internal:8080/v1
FISH_MLX_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
FISH_MLX_UPSTREAM_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
FISH_MLX_CONTEXT_TOKENS=4096
FISH_MLX_API_KEY=

# Fish warm inference starter profile: reliable 8B chat.
# Recommended VM: NVIDIA L4 24GB, RTX 4090 24GB, RTX 3090 24GB, or better.

FISH_VLLM_IMAGE=vllm/vllm-openai:latest
FISH_VLLM_API_KEY=replace-with-long-vllm-secret
FISH_VLLM_MODEL=Qwen/Qwen3-8B
FISH_VLLM_SERVED_MODEL_NAME=fish-warm-chat
FISH_VLLM_MAX_MODEL_LEN=8192
FISH_VLLM_GPU_MEMORY_UTILIZATION=0.88

FISH_RUNNER_ID=runner_ocean_navy_qwen3_8b
FISH_RUNNER_PROVIDER_ID=ocean-navy-demo-node
FISH_RUNNER_API_KEY=replace-with-different-long-runner-secret
FISH_RUNNER_PRICE_USD_PER_1K_TOKENS=0
FISH_RUNNER_MAX_QUEUE=3
FISH_RUNNER_SIGNING_PRIVATE_KEY_PEM=
FISH_RUNNER_SIGNING_KEY_ID=runner-ocean-navy-qwen3-8b-ed25519

HUGGING_FACE_HUB_TOKEN=

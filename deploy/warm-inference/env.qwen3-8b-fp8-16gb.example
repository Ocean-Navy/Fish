# Fish warm inference low-VRAM profile.
# Use this when the VM only has a 16GB card such as RTX 4080 / RTX 4080 SUPER.
# Prefer a 24GB+ GPU for the public pilot if available.

FISH_VLLM_IMAGE=vllm/vllm-openai:latest
FISH_VLLM_API_KEY=replace-with-long-vllm-secret
FISH_VLLM_MODEL=Qwen/Qwen3-8B-FP8
FISH_VLLM_SERVED_MODEL_NAME=fish-warm-chat
FISH_VLLM_MAX_MODEL_LEN=4096
FISH_VLLM_GPU_MEMORY_UTILIZATION=0.88

FISH_RUNNER_ID=runner_ocean_navy_qwen3_8b_fp8
FISH_RUNNER_PROVIDER_ID=ocean-navy-low-vram-demo-node
FISH_RUNNER_API_KEY=replace-with-different-long-runner-secret
FISH_RUNNER_PRICE_USD_PER_1K_TOKENS=0
FISH_RUNNER_MAX_QUEUE=1
FISH_RUNNER_SIGNING_PRIVATE_KEY_PEM=
FISH_RUNNER_SIGNING_KEY_ID=runner-ocean-navy-qwen3-8b-fp8-ed25519

HUGGING_FACE_HUB_TOKEN=

# Production env for serving op.fish from this machine.
# Copy to .env.op.fish.local in the prod checkout and fill in real values.
# The launchd service sources this file before `npm run start`.

# --- Required (production boot validation refuses to start without these) ---
NODE_ENV=production
FISH_ADMIN_TOKEN=replace-with-a-long-random-secret-you-generate
FISH_GUEST_ID_SALT=replace-with-a-different-long-random-secret

# --- Server binding: loopback only; the tunnel is the sole way in ---
PORT=3000
HOSTNAME=127.0.0.1

# --- Chat route ---
# Honest default for always-on public serving is mock unless the MLX/runner
# stack is genuinely running whenever the site is up:
FISH_CHAT_ROUTE=mock
# When the warm stack IS up, switch to the overlay from `npm run ocean-demo:web-env -- --profile mlx`:
# FISH_CHAT_ROUTE=ocean-demo-vllm
# FISH_OCEAN_DEMO_VLLM_BASE_URL=http://127.0.0.1:8088/v1
# FISH_OCEAN_DEMO_VLLM_API_KEY=...
# FISH_OCEAN_DEMO_VLLM_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
# FISH_OCEAN_DEMO_PROVIDER_ID=ocean-navy-local-mlx
# FISH_RUNNER_PUBLIC_KEY_ID=...
# FISH_RUNNER_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- Guardrails (defaults shown; tune for public traffic) ---
FISH_CHAT_TIMEOUT_MS=60000
FISH_DAILY_ANONYMOUS_QUOTA=5
FISH_DAILY_KEYED_QUOTA=20
FISH_OCEAN_DEMO_DAILY_BUDGET_USD=10
# Emergency stop (set true + restart the service):
# FISH_ROUTER_KILL_SWITCH=true
